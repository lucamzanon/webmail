# Test files are never part of the image, and `next build` type-checks
# whatever reaches the context: lib/__tests__/lite-scripts.test.ts imports
# scripts/lite/*.mjs, which .dockerignore excludes, so the build fails.
**/__tests__/
**/*.test.ts
**/*.test.tsx
# Sibling projects / test harness - not part of the webmail image
examples/
# Unit tests: `next build` type-checks every .ts file, and some tests import
# routes the Dockerfile deletes (app/api/dev-jmap). The Dockerfile deletes the
# tests as well, since a remote Git context skips this file.
**/__tests__
**/*.test.ts
**/*.test.tsx
integration/
repos/
# Runtime state of a checkout that has been run (admin password hash,
# plugin signing key, audit log, synced settings) - never part of an image
data/
local-data/
**/node_modules
